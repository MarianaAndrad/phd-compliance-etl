# MONGO
MONGO_PORT=27017

MONGO_INITDB_ROOT_USERNAME=mongoUser
MONGO_INITDB_ROOT_PASSWORD=mongoPassword

DB_MONGO_USERNAME=mongo
DB_MONGO_PASSWORD=mongo
DB_MONGO_NAME=mydatabase

DB_MONGO_CATALOG_COLLECTION=catalog
DB_MONGO_CONTROL_COLLECTION=control

# ELASTICSEARCH
ES_PORT=9200

ES_USERNAME=elastic
ES_PASSWORD=elasticPassword

# KIBANA
KIBANA_PORT=5601
# password for the built-in kibana_system user (set by the kibana-setup service)
KIBANA_PASSWORD=kibanaPassword
